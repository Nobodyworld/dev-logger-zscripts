{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/zscripts/normalized-log.schema.json",
  "title": "NormalizedLog",
  "type": "object",
  "required": [
    "tool",
    "ecosystem",
    "command",
    "status",
    "summary",
    "timestamp",
    "errors",
    "warnings",
    "artifacts",
    "metadata"
  ],
  "properties": {
    "tool": {"type": "string"},
    "ecosystem": {"type": "string"},
    "command": {"type": "string"},
    "status": {"type": "string"},
    "summary": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {"type": "string"},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 0},
          "column": {"type": ["integer", "null"], "minimum": 0},
          "code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {"type": "string"},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 0},
          "column": {"type": ["integer", "null"], "minimum": 0},
          "code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": ["object", "null"],
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "duration": {"type": ["number", "null"], "minimum": 0},
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "status": {"type": "string"},
              "duration": {"type": ["number", "null"], "minimum": 0},
              "message": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "additionalProperties": false
}
